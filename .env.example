# ===========================================
# WebCraft Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control

# App Environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Admin Panel (Local Development Only)
# ===========================================
# Set to 'true' to enable admin panel locally
# DO NOT set this in production (Vercel) - admin will show 404
ENABLE_ADMIN=true

# SEO & Verification
GOOGLE_SITE_VERIFICATION=your_google_verification_code
YANDEX_VERIFICATION=your_yandex_verification_code

# ===========================================
# Supabase Configuration (REQUIRED for Phase 12)
# ===========================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Public URL - safe for client-side
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon Key - safe for client-side (RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Service Role Key - SERVER ONLY, NEVER expose to client
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ===========================================
# CAPTCHA Configuration (reCAPTCHA v3)
# ===========================================
# Get keys from: https://www.google.com/recaptcha/admin
# Choose reCAPTCHA v3 for invisible protection

# Public site key - safe for client-side
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Secret key - SERVER ONLY
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Alternative: hCaptcha (if preferred over reCAPTCHA)
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
# HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key

# ===========================================
# Cron Job Security
# ===========================================
# Secret for authenticating scheduled cleanup jobs
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# ===========================================
# Email Service - Nodemailer (Phase 16)
# ===========================================
# SMTP Configuration (Gmail, Outlook, or any SMTP server)

# SMTP Host (examples: smtp.gmail.com, smtp.office365.com, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use SSL (true for port 465, false for 587)
SMTP_SECURE=false

# SMTP Username (your email address)
SMTP_USER=your-email@gmail.com

# SMTP Password (for Gmail, use App Password - not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password

# Email sender address
EMAIL_FROM_ADDRESS=WebCraft <your-email@gmail.com>

# Admin notification emails (comma-separated for multiple admins)
ADMIN_NOTIFICATION_EMAILS=admin@webcraft.com

# Site URL for email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# Analytics (Future)
# ===========================================
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
