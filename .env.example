# ===========================================
# Email Service - Nodemailer (Phase 16)
# ===========================================
# SMTP Configuration (Gmail, Outlook, or any SMTP server)

# SMTP Host (examples: smtp.gmail.com, smtp.office365.com, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use SSL (true for port 465, false for 587)
SMTP_SECURE=false

# SMTP Username (your email address)
SMTP_USER=your-email@gmail.com

# SMTP Password (for Gmail, use App Password - not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password

# Email sender address
EMAIL_FROM_ADDRESS=WebCraft <your-email@gmail.com>

# Admin notification emails (comma-separated for multiple admins)
ADMIN_NOTIFICATION_EMAILS=admin@webcraft.com

# Site URL for email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# Analytics (Future)
# ===========================================
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
