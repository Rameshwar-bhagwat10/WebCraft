# ===========================================
# WebCraft Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control

# App Environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Admin Panel (Local Development Only)
# ===========================================
# Set to 'true' to enable admin panel locally
# DO NOT set this in production (Vercel) - admin will show 404
ENABLE_ADMIN=true

# SEO & Verification
GOOGLE_SITE_VERIFICATION=your_google_verification_code
YANDEX_VERIFICATION=your_yandex_verification_code

# ===========================================
# Supabase Configuration (REQUIRED for Phase 12)
# ===========================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Public URL - safe for client-side
NEXT_PUBLIC_SUPABASE_URL=https://jagukdaeozdxguscapxv.supabase.co

# Anon Key - safe for client-side (RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImphZ3VrZGFlb3pkeGd1c2NhcHh2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjcxNzQ5OTAsImV4cCI6MjA4Mjc1MDk5MH0.yYiaUZYGiKkOdj9zHVgN2W39y6UwnXqC0YQ9LObM2qQ

